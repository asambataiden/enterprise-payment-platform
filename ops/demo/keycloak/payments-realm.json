{
    "realm": "payments",
    "enabled": true,
    "displayName": "Enterprise Payment Platform - Local Demo",
    "sslRequired": "none",
    "clientScopes": [
        {"name":"payments:read","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}},
        {"name":"payments:write","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}},
        {"name":"payments:simulate","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}}
    ],
    "clients": [
        {
            "clientId": "payment-demo-cli",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "serviceAccountsEnabled": true,
            "standardFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "implicitFlowEnabled": false,
            "defaultClientScopes": ["payments:read","payments:write","payments:simulate"],
            "protocolMappers": [
                {
                    "name":"payment-api-audience",
                    "protocol":"openid-connect",
                    "protocolMapper":"oidc-audience-mapper",
                    "config": {"included.custom.audience":"enterprise-payment-service","access.token.claim":"true","id.token.claim":"false"}
                },
                {
                    "name":"demo-merchant-identity",
                    "protocol":"openid-connect",
                    "protocolMapper":"oidc-hardcoded-claim-mapper",
                    "config": {"claim.name":"merchant_id","claim.value":"merchant-demo-001","jsonType.label":"String","access.token.claim":"true","id.token.claim":"false"}
                }
            ]
        }
    ]
}
